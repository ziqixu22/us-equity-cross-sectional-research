# Environments and local settings
.venv/
.env
.DS_Store

# Raw data, caches, and large generated artifacts
data/raw/
data/interim/
data/processed/
data/manifests/*.json
reports/*.pdf
# Note: reports/figures/ is intentionally NOT ignored -- these are
# final, small (<2MB total) generated deliverable figures referenced
# throughout reports/ and README.md, not scratch/cache output.

# Notebook runtime state
.ipynb_checkpoints/
__pycache__/
.pytest_cache/
.ruff_cache/
*.py[cod]

# Build metadata from editable installs
*.egg-info/
